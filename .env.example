# URL del backend (sin /api/v1). En desarrollo puede quedar vacía: Vite hace proxy a localhost:8080.
VITE_API_URL=http://localhost:8080

# Backend al que apunta el proxy de Vite en desarrollo (solo si no es localhost:8080).
# VITE_API_PROXY_TARGET=http://localhost:8080

